POSTGRES_DB=chamados_ia
POSTGRES_USER=chamados_ia
POSTGRES_PASSWORD=change_me

DB_HOST=db
DB_PORT=5432
DB_NAME=chamados_ia
DB_USER=chamados_ia
DB_PASSWORD=change_me
# Mude para "true" em produção (Neon, Render, etc.) — exige SSL na conexão com o Postgres.
DB_SSL=false

# Chave que protege a API REST (/api/chamados) — não é senha de usuário, é uma
# credencial de sistema exigida no header X-API-Key em toda requisição.
# Gere um valor aleatório único, ex.: php -r "echo bin2hex(random_bytes(24));"
API_KEY=defina_uma_chave_aleatoria_aqui

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

FIRECRAWL_API_KEY=

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=chamados@seudominio.com
